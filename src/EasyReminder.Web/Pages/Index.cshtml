@page
@model IndexModel
@{
    ViewData["Title"] = "Yaklaşan Hatırlatmalar";
}

<header class="app-header">
    <a class="brand" asp-page="/Index" aria-label="Easy Reminder ana sayfa">
        <svg class="brand__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.6 4.8 5.2 3.4M17.4 4.8l1.4-1.4M5 10a7 7 0 1 1 14 0v4.2l1.4 2.3H3.6L5 14.2V10Zm4.5 9a2.7 2.7 0 0 0 5 0" />
        </svg>
        <span>Easy Reminder</span>
    </a>

    <span class="header-icon" aria-label="Hesap özelliği daha sonra eklenecek" role="img">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2" />
            <circle cx="12" cy="12" r="8" />
            <path d="M6.8 17.5c1.2-2.2 3-3.3 5.2-3.3s4 1.1 5.2 3.3" />
        </svg>
    </span>
</header>

<main class="page-content upcoming-page">

    @if (!Model.HasUpcomingReminders)
    {
        <section class="empty-state" aria-labelledby="empty-state-title">
            <div class="empty-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M7 9a5 5 0 0 1 10 0v3.8l1.4 2.2H5.6L7 12.8V9Z" />
                    <path d="M10 18a2.2 2.2 0 0 0 4 0M9 3.8 7.8 2.6M15 3.8l1.2-1.2" />
                </svg>
            </div>
            <h1 id="empty-state-title">Yaklaşan hatırlatman yok</h1>
            <p class="empty-state__description">İlk hatırlatmanı oluştur; zamanı geldiğinde sana Telegram üzerinden haber verelim.</p>
            <a class="button button--primary" asp-page="/Reminders/New">
                <span aria-hidden="true">＋</span>
                Hatırlatma oluştur
            </a>
        </section>
    }
</main>

<a class="fab" asp-page="/Reminders/New" aria-label="Yeni hatırlatma oluştur">＋</a>

<nav class="bottom-nav" aria-label="Ana navigasyon">
    <a class="bottom-nav__item bottom-nav__item--active" asp-page="/Index" aria-current="page">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="4" y="5.5" width="16" height="14" rx="2" />
            <path d="M8 3v5M16 3v5M4 10h16" />
        </svg>
        <span>Yaklaşan</span>
    </a>
    <a class="bottom-nav__item" asp-page="/Reminders/New">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8" />
            <path d="M12 8v8M8 12h8" />
        </svg>
        <span>Yeni</span>
    </a>
    <span class="bottom-nav__item bottom-nav__item--disabled" aria-disabled="true" title="Geçmiş ekranı daha sonra eklenecek">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.6M4 4v4.6h4.6M12 7.5V12l3 2" />
        </svg>
        <span>Geçmiş</span>
    </span>
</nav>
