@page
@model EasyReminder.Web.Pages.Reminders.NewModel
@{
    ViewData["Title"] = "Yeni Hatırlatma";
}

<header class="app-header app-header--editor">
    <a class="header-icon" asp-page="/Index" aria-label="Yaklaşan hatırlatmalara dön">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 5-7 7 7 7M8 12h11" />
        </svg>
    </a>
    <h1>Yeni Hatırlatma</h1>
    <span class="header-icon header-icon--accent" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <path d="M6.6 4.8 5.2 3.4M17.4 4.8l1.4-1.4M5 10a7 7 0 1 1 14 0v4.2l1.4 2.3H3.6L5 14.2V10Z" />
        </svg>
    </span>
</header>

<main class="page-content editor-page">
    <p class="prototype-note">Bu ekranın backend bağlantısını sonraki form ödevinde birlikte kuracağız.</p>

    <div class="reminder-form" aria-label="Yeni hatırlatma formu görsel taslağı">
        <div class="field-group">
            <label for="reminder-title">Başlık <span class="required-mark">*</span></label>
            <input id="reminder-title" type="text" maxlength="80" placeholder="Sana neyi hatırlatalım?" />
            <span class="character-count" data-counter-for="reminder-title">0/80</span>
        </div>

        <div class="field-group">
            <label for="reminder-description">Açıklama</label>
            <textarea id="reminder-description" maxlength="500" rows="3" placeholder="İstersen ayrıntı ekleyebilirsin..."></textarea>
            <span class="character-count" data-counter-for="reminder-description">0/500</span>
        </div>

        <fieldset class="frequency-card">
            <legend>Hatırlatma sıklığı</legend>
            <div class="segmented-control">
                <input id="one-time" name="frequency" type="radio" checked />
                <label for="one-time">Bir kere</label>
                <input id="recurring" name="frequency" type="radio" />
                <label for="recurring">Tekrarlayan</label>
            </div>
        </fieldset>

        <section class="notification-section" aria-labelledby="notification-title">
            <h2 id="notification-title">BİLDİRİM ZAMANI</h2>
            <div class="date-row">
                <span aria-hidden="true">◷</span>
                <input type="datetime-local" aria-label="Bildirim zamanı" />
            </div>
            <button class="button button--outline" type="button" disabled>
                <span aria-hidden="true">＋</span>
                Başka bildirim ekle
            </button>
        </section>
    </div>
</main>

<div class="editor-action-bar">
    <button class="button button--save" type="button" disabled>
        <span aria-hidden="true">✓</span>
        Hatırlatmayı kaydet
    </button>
</div>
